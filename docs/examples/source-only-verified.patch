--- /dev/null
+++ b/modules/ai-search/tests/generated.tftest.hcl
@@ -0,0 +1,150 @@
+mock_provider "azurerm" {
+  override_during = plan
+  mock_resource "azurerm_search_service" {
+    defaults = {
+      id = "/subscriptions/00000000-0000-0000-0000-000000000000/resourceGroups/rg-test/providers/Microsoft.Search/searchServices/search-test"
+      identity = {
+        principal_id = "00000000-0000-0000-0000-000000000001"
+        tenant_id    = "00000000-0000-0000-0000-000000000002"
+      }
+    }
+  }
+}
+
+variables {
+  name                = "search-test"
+  resource_group_name = "rg-test"
+  location            = "westeurope"
+}
+
+run "default_configuration" {
+  command = plan
+
+  assert {
+    condition     = azurerm_search_service.this.sku == "basic"
+    error_message = "Default SKU should be basic."
+  }
+
+  assert {
+    condition     = azurerm_search_service.this.replica_count == 1
+    error_message = "Default replica count should be 1."
+  }
+
+  assert {
+    condition     = azurerm_search_service.this.public_network_access_enabled == false
+    error_message = "Public network access should be disabled by default."
+  }
+
+  assert {
+    condition     = azurerm_search_service.this.local_authentication_enabled == false
+    error_message = "Local authentication should be disabled by default."
+  }
+}
+
+run "caller_overrides" {
+  command = plan
+
+  variables {
+    sku           = "standard"
+    replica_count = 2
+  }
+
+  assert {
+    condition     = azurerm_search_service.this.sku == "standard"
+    error_message = "SKU should be overridden to standard."
+  }
+
+  assert {
+    condition     = azurerm_search_service.this.replica_count == 2
+    error_message = "Replica count should be overridden to 2."
+  }
+}
+
+run "output_wiring" {
+  command = plan
+
+  assert {
+    condition     = output.id == azurerm_search_service.this.id
+    error_message = "Output id does not match resource id."
+  }
+
+  assert {
+    condition     = output.name == azurerm_search_service.this.name
+    error_message = "Output name does not match resource name."
+  }
+
+  assert {
+    condition     = output.principal_id == azurerm_search_service.this.identity[0].principal_id
+    error_message = "Output principal_id does not match resource identity principal_id."
+  }
+}
+
+run "validation_name_blank" {
+  command = plan
+  variables {
+    name = ""
+  }
+  expect_failures = [var.name]
+}
+
+run "validation_name_whitespace" {
+  command = plan
+  variables {
+    name = "   "
+  }
+  expect_failures = [var.name]
+}
+
+run "validation_sku_invalid" {
+  command = plan
+  variables {
+    sku = "premium"
+  }
+  expect_failures = [var.sku]
+}
+
+run "validation_replica_count_too_low" {
+  command = plan
+  variables {
+    replica_count = 0.0
+  }
+  expect_failures = [var.replica_count]
+}
+
+run "validation_replica_count_too_high" {
+  command = plan
+  variables {
+    replica_count = 4.0
+  }
+  expect_failures = [var.replica_count]
+}
+
+run "validation_replica_count_non_integer" {
+  command = plan
+  variables {
+    replica_count = 1.5
+  }
+  expect_failures = [var.replica_count]
+}
+
+run "validation_replica_count_min_valid" {
+  command = plan
+  variables {
+    replica_count = 1
+  }
+  assert {
+    condition     = azurerm_search_service.this.replica_count == 1
+    error_message = "Replica count of 1 should be valid."
+  }
+}
+
+run "validation_replica_count_max_valid" {
+  command = plan
+  variables {
+    replica_count = 3
+  }
+  assert {
+    condition     = azurerm_search_service.this.replica_count == 3
+    error_message = "Replica count of 3 should be valid."
+  }
+}
--- /dev/null
+++ b/modules/aks/tests/generated.tftest.hcl
@@ -0,0 +1,163 @@
+mock_provider "azurerm" {
+  override_during = plan
+  mock_resource "azurerm_kubernetes_cluster" {
+    defaults = {
+      id           = "/subscriptions/00000000-0000-0000-0000-000000000000/resourceGroups/rg-test/providers/Microsoft.ContainerService/managedClusters/aks-test"
+      private_fqdn = "aks-test-private.00000000-0000-0000-0000-000000000000.privatelink.westeurope.azmk8s.io"
+      identity = {
+        principal_id = "00000000-0000-0000-0000-000000000001"
+        tenant_id    = "00000000-0000-0000-0000-000000000002"
+      }
+    }
+  }
+}
+
+variables {
+  name                = "aks-test"
+  resource_group_name = "rg-test"
+  location            = "westeurope"
+  dns_prefix          = "akstest"
+  tenant_id           = "00000000-0000-0000-0000-000000000002"
+}
+
+run "default_configuration" {
+  command = plan
+
+  assert {
+    condition     = azurerm_kubernetes_cluster.this.name == "aks-test"
+    error_message = "Cluster name did not match expected value."
+  }
+
+  assert {
+    condition     = azurerm_kubernetes_cluster.this.private_cluster_enabled == true
+    error_message = "Private cluster must be enabled."
+  }
+
+  assert {
+    condition     = azurerm_kubernetes_cluster.this.private_cluster_public_fqdn_enabled == false
+    error_message = "Private cluster public FQDN must be disabled."
+  }
+
+  assert {
+    condition     = azurerm_kubernetes_cluster.this.local_account_disabled == true
+    error_message = "Local accounts must be disabled."
+  }
+
+  assert {
+    condition     = azurerm_kubernetes_cluster.this.role_based_access_control_enabled == true
+    error_message = "RBAC must be enabled."
+  }
+
+  assert {
+    condition     = azurerm_kubernetes_cluster.this.default_node_pool[0].node_count == 2
+    error_message = "Default node count must be 2."
+  }
+
+  assert {
+    condition     = azurerm_kubernetes_cluster.this.default_node_pool[0].vm_size == "Standard_D2s_v5"
+    error_message = "Default VM size must be Standard_D2s_v5."
+  }
+
+  assert {
+    condition     = azurerm_kubernetes_cluster.this.default_node_pool[0].node_public_ip_enabled == false
+    error_message = "Node public IP must be disabled."
+  }
+
+  assert {
+    condition     = azurerm_kubernetes_cluster.this.azure_active_directory_role_based_access_control[0].azure_rbac_enabled == true
+    error_message = "Azure RBAC must be enabled."
+  }
+
+  assert {
+    condition     = output.id == azurerm_kubernetes_cluster.this.id
+    error_message = "Output id does not match resource id."
+  }
+
+  assert {
+    condition     = output.private_fqdn == azurerm_kubernetes_cluster.this.private_fqdn
+    error_message = "Output private_fqdn does not match resource private_fqdn."
+  }
+
+  assert {
+    condition     = output.principal_id == azurerm_kubernetes_cluster.this.identity[0].principal_id
+    error_message = "Output principal_id does not match resource identity principal_id."
+  }
+}
+
+run "validation_name_blank" {
+  command = plan
+  variables {
+    name = ""
+  }
+  expect_failures = [var.name]
+}
+
+run "validation_name_whitespace" {
+  command = plan
+  variables {
+    name = "   "
+  }
+  expect_failures = [var.name]
+}
+
+run "validation_dns_prefix_blank" {
+  command = plan
+  variables {
+    dns_prefix = ""
+  }
+  expect_failures = [var.dns_prefix]
+}
+
+run "validation_dns_prefix_whitespace" {
+  command = plan
+  variables {
+    dns_prefix = "   "
+  }
+  expect_failures = [var.dns_prefix]
+}
+
+run "validation_node_count_too_low" {
+  command = plan
+  variables {
+    node_count = 0.0
+  }
+  expect_failures = [var.node_count]
+}
+
+run "validation_node_count_too_high" {
+  command = plan
+  variables {
+    node_count = 6.0
+  }
+  expect_failures = [var.node_count]
+}
+
+run "validation_node_count_non_integer" {
+  command = plan
+  variables {
+    node_count = 1.5
+  }
+  expect_failures = [var.node_count]
+}
+
+run "validation_node_count_min_valid" {
+  command = plan
+  variables {
+    node_count = 1
+  }
+  assert {
+    condition     = azurerm_kubernetes_cluster.this.default_node_pool[0].node_count == 1
+    error_message = "Node count 1 should be accepted."
+  }
+}
+
+run "validation_node_count_max_valid" {
+  command = plan
+  variables {
+    node_count = 5
+  }
+  assert {
+    condition     = azurerm_kubernetes_cluster.this.default_node_pool[0].node_count == 5
+    error_message = "Node count 5 should be accepted."
+  }
+}
